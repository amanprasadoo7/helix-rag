# Copy to .env and fill in. Never commit .env.

# --- App ---
# Allowed: local | dev | test | staging | prod
HELIX_APP_ENV=local
# Allowed: DEBUG | INFO | WARNING | ERROR | CRITICAL
HELIX_LOG_LEVEL=INFO
# Bind address for the local dev server (python -m apps.api.dev).
# Use 0.0.0.0 inside Docker so the container is reachable.
HELIX_API_HOST=127.0.0.1
HELIX_API_PORT=8000

# --- Postgres ---
HELIX_POSTGRES_HOST=127.0.0.1
HELIX_POSTGRES_PORT=5432
HELIX_POSTGRES_USER=helix
HELIX_POSTGRES_PASSWORD=helix_dev_password
HELIX_POSTGRES_DB=helix

# --- Redis ---
HELIX_REDIS_HOST=127.0.0.1
HELIX_REDIS_PORT=6379
HELIX_REDIS_DB=0

# --- Qdrant ---
HELIX_QDRANT_HOST=127.0.0.1
HELIX_QDRANT_PORT=6333
HELIX_QDRANT_GRPC_PORT=6334

# --- MinIO (S3-compatible) ---
# Host ports 9100/9101 because 9000/9001 are used by Portainer here.
HELIX_MINIO_HOST=127.0.0.1
HELIX_MINIO_PORT=9100
HELIX_MINIO_CONSOLE_PORT=9101
HELIX_MINIO_USER=helix
HELIX_MINIO_PASSWORD=helix_minio_dev_password
HELIX_MINIO_SECURE=false

# --- Developer GUIs (optional, start with `make tools`) ---
HELIX_ADMINER_PORT=8081
HELIX_REDISINSIGHT_PORT=5540

# --- Model providers (added in later checkpoints) ---
# GROQ_API_KEY=
# HF_TOKEN=
